build/
install/
log/
__pycache__/
*.pyc
*.egg-info/
.claude/
# Third-party ROS2 packages (cloned during setup, not part of this repo)
deploy/ros2_ws/src/aruco_ros/
deploy/ros2_ws/src/easy_handeye2/

# Sim 객체 래퍼 — setup_objects.py 가 환경별로 재생성 (절대경로 baked).
# 모든 도메인 하위 디렉터리(recycling, tableware, …) 의 .usd 를 제외.
sim/assets/objects/*/*.usd

# Cat-C verify 렌더링 PNG — render_verify_images.py 로 재생성 가능
# (입력: scenarios sidecar + base_scene + 래퍼 USD). 도메인별 ~500개 × 280KB.
# 시드/scenario 동일 시 거의 같게 재현되므로 추적 불필요. EC2 와 로컬 양쪽에
# 보관됨.
training/lora_finetuning/data/*/verify_images/

# 학습 산출물 — 용량 큼, 코드+dataset 으로 재학습 재현 가능.
#   - lora_finetuning/outputs/ : Gemma LoRA (adapter_model.safetensors + checkpoint-*, 도메인당 ~600MB)
#   - ACT 학습 출력은 models/ 아래(train_act.sh 기본 OUTPUT_DIR=models/act/outputs/<domain>)
#     로 변경됨 → 위 models/ 규칙이 커버(별도 항목 불필요).
# 추후 버전 관리 필요 시 GitHub Release / HF Hub private repo 고려.
training/lora_finetuning/outputs/

# 모방데이터 수집 원본 (LeRobotDataset: parquet + videos + meta + labels.jsonl).
# record_real_teleop.py 산출물 — 재수집 불가한 비싼 원본이므로 로컬/외부 백업 필수.
training/imitation_data/datasets/

# 배포 모델 산출물 (전부 용량 큼 — gitignore. 로컬/외부 백업 필수).
#   - models/gemma/adapters/adapter_*.gguf  : Gemma LoRA GGUF (convert_lora_to_gguf.sh 로 재생성, ~97MB/파일)
#   - models/act/<domain>/pretrained_model  : 학습된 ACT 정책 (외부 학습 환경 산출물).
#       config.json + model.safetensors(~200MB) + pre/post processor(정규화 — 배포 필수) + train_config.json.
#       Jetson ~/models/act/<domain>/pretrained_model 로 배포. 재학습 외엔 재현 어려움.
models/
